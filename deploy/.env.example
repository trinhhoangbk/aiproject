# ================================================================
# Hub — environment template
# Copy to .env (same directory) and `chmod 600 .env` before `docker compose up`.
# NEVER commit the real .env.
# PLAN-COND-01: this template ships with JIRA_WRITE_DRY_RUN=true.
# ================================================================

# ----- Database -----
POSTGRES_DB=hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=change_me_before_first_boot

# ----- Hub image version (match app/build.gradle.kts) -----
HUB_VERSION=0.1.0-SNAPSHOT

# ----- Jira Cloud Free (ADR-ARCH-001, ADR-ARCH-010) -----
# Non-production site only — see CP-1 operator checklist.
JIRA_BASE_URL=https://your-tenant.atlassian.net
JIRA_USER_EMAIL=hub-bot@example.com
JIRA_API_TOKEN=paste_the_atlassian_api_token_here
JIRA_WEBHOOK_SECRET=generate_32_bytes_random_hex

# PLAN-COND-01 — DO NOT change the default to `false` on first boot.
# Flip to false only after CP-1 and smoke-test PS-01..PS-08 are green.
JIRA_WRITE_DRY_RUN=true

# ----- Public tunnel URL (ngrok or cloudflared) -----
# Jira webhook URL must point at ${HUB_PUBLIC_URL}/webhooks/jira — and NO other path (TD-COND-01).
HUB_PUBLIC_URL=https://your-stable-tunnel.example.com

# ----- Audit retention (F-ARCH-NEW-02 Reading A) -----
AUDIT_RETENTION_DAYS=30
KAFKA_AUDIT_RETENTION_HOURS=168

# ----- Bootstrap Admin (TD-012, PLAN-030) -----
# First boot of a fresh DB creates one Admin with this email + a ONE-TIME password
# printed to stdout. After capture, change the password AND clear your terminal
# scrollback (PLAN-COND-04).
HUB_BOOTSTRAP_ADMIN_EMAIL=you@example.com

# ----- Kafka cluster ID (KRaft) -----
# Pre-generated with: kafka-storage random-uuid
KAFKA_CLUSTER_ID=9MLSTKC0SxuW1KUR8kjYwQ
