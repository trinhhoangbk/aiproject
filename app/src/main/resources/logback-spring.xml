<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON logs to stdout + secret masking (05 Security §8, PLAN-034).
  Patterns matching token / secret / password / api-key are masked at render time.
-->
<configuration scan="false">

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ch.qos.logback.classic.PatternLayout">
                <pattern>
                    {"ts":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,Asia/Saigon}","level":"%level","logger":"%logger{40}","thread":"%thread","msg":"%replace(%msg){'(?i)(token|secret|password|api[-_]?key)[\" ]*[:=][\" ]*[^,\" }]+','$1=***'}","trace":"%X{traceId:-}","req":"%X{requestId:-}"%n%replace(%ex){'(?i)(token|secret|password|api[-_]?key)[\" ]*[:=][\" ]*[^,\" }]+','$1=***'}}%n
                </pattern>
            </layout>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="com.mbs.hub" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
</configuration>
