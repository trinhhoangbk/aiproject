<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON logs to stdout (PLAN-034).
  Secret masking lives in SecretMasker (audit layer) + application-level discipline;
  the earlier inline regex pattern tripped Logback's own tokenizer.
-->
<configuration scan="false">

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX, Asia/Saigon} %-5level [%thread] %logger{40} req=%X{requestId:-} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="com.mbs.hub" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
</configuration>
